NODE_ENV=production
PORT=3000
# Set unique random PINs, at least 12 characters each in production.
TCC_EMPLOYEE_TCC_01_PIN=
TCC_EMPLOYEE_TCC_02_PIN=
TCC_EMPLOYEE_TCC_03_PIN=
# 1 when running behind Render, Railway, Fly.io or Nginx (needed for correct rate limits and HTTPS detection)
TRUST_PROXY=1
FORCE_HTTPS=true
# Optional persistent data directory; defaults to ./data.
TCC_DATA_DIR=
